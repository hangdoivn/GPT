# ─────────────────────────────────────────────────────────────
#  Cấu hình deploy VPS bằng Docker Compose.
#  Cách nhanh nhất: chạy ./deploy.sh (tự điền & sinh secret).
#  Cách thủ công: copy file này thành `.env`, điền giá trị, rồi:
#     docker compose up -d --build
#  LƯU Ý: KHÔNG commit file `.env` thật (đã nằm trong .gitignore).
# ─────────────────────────────────────────────────────────────

# Domain đã trỏ A record về IP của VPS (KHÔNG kèm https://)
DOMAIN="social.hangdoistudio.vn"

# Mật khẩu cho database Postgres (đặt chuỗi mạnh; deploy.sh tự sinh nếu bỏ trống)
DB_PASSWORD="DOI-MAT-KHAU-MANH-O-DAY"

# ── Facebook App ──
# App ID không bí mật (lộ trong URL OAuth). App Secret là BÍ MẬT — điền trên VPS,
# không để trong file commit lên GitHub.
FACEBOOK_APP_ID="1424421672856268"
FACEBOOK_APP_SECRET="DIEN-APP-SECRET-CUA-BAN-TREN-VPS"
FACEBOOK_GRAPH_VERSION="v21.0"

# Chuỗi bí mật webhook & cron (deploy.sh tự sinh ngẫu nhiên nếu bỏ trống)
FACEBOOK_WEBHOOK_VERIFY_TOKEN="TU-SINH-KHI-CHAY-DEPLOY"
CRON_SECRET="TU-SINH-KHI-CHAY-DEPLOY"

# ── AI viết lại caption (Copy IG→Fanpage) ──
# Bỏ trống thì tính năng vẫn chạy nhưng dùng fallback (caption gốc + CTA + hashtag),
# không gọi AI. Điền key để AI (Claude Opus) viết lại caption theo định vị page đích.
ANTHROPIC_API_KEY=""
IG_CAPTION_MODEL="claude-opus-4-8"

# ── Đọc bài Instagram (scope instagram_basic) ──
# Mặc định BẬT (để trống = bật). Yêu cầu FB App đã thêm sản phẩm "Instagram"
# (developers.facebook.com → App → Add product → Instagram / Instagram API with Facebook Login).
# Đặt =0 để TẮT khẩn cấp nếu Facebook chặn đăng nhập ("Invalid Scopes: instagram_basic").
ENABLE_IG_SCOPE=""
