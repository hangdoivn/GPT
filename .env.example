# ─────────────────────────────────────────────────────────────
#  Hàng Đôi Fanpage Manager — cấu hình môi trường
#  Copy file này thành `.env` rồi điền giá trị thật.
# ─────────────────────────────────────────────────────────────

# Database (SQLite mặc định — không cần cài server)
DATABASE_URL="file:./dev.db"

# ── Facebook App (BẮT BUỘC để đăng nhập OAuth) ────────────────
# Tạo app tại https://developers.facebook.com/apps
# Đây là thông tin cấp APP (không đổi theo user). Sau khi điền,
# vào trang Cài đặt trong app và bấm "Đăng nhập với Facebook" —
# token của page + ad account sẽ được lấy & lưu tự động.
# Nhớ thêm URL callback vào Facebook Login > Valid OAuth Redirect URIs:
#   <APP_URL>/api/auth/facebook/callback
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# URL gốc của app (dùng để tạo redirect_uri OAuth).
# Local để trống là được (tự lấy từ request). Production thì đặt domain thật.
APP_URL=""

# Phiên bản Graph API
FACEBOOK_GRAPH_VERSION="v21.0"

# ── (TUỲ CHỌN) Cấu hình token thủ công ────────────────────────
# Chỉ dùng nếu KHÔNG muốn đăng nhập OAuth. Bình thường để trống.
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
FACEBOOK_AD_ACCOUNT_ID=""

# ── Webhook (nhận lead realtime từ Lead Ads) ──────────────────
# Chuỗi bí mật để xác thực webhook subscription
FACEBOOK_WEBHOOK_VERIFY_TOKEN="doi-mat-khau-nay"
