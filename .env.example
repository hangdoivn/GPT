# ─────────────────────────────────────────────────────────────
#  Hàng Đôi Fanpage Manager — cấu hình môi trường
#  Copy file này thành `.env` rồi điền giá trị thật.
# ─────────────────────────────────────────────────────────────

# Database (SQLite mặc định — không cần cài server)
DATABASE_URL="file:./dev.db"

# ── Facebook App ──────────────────────────────────────────────
# Tạo app tại https://developers.facebook.com/apps
# Cần các quyền: pages_show_list, pages_read_engagement,
# pages_manage_posts, pages_manage_metadata, leads_retrieval,
# ads_read, ads_management, business_management
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Token truy cập dài hạn (long-lived) của Page hoặc System User.
# Lấy qua Graph API Explorer hoặc luồng OAuth trong app.
FACEBOOK_PAGE_ACCESS_TOKEN=""

# ID của Page Hàng Đôi (lấy từ /me/accounts)
FACEBOOK_PAGE_ID=""

# Ad Account ID cho Marketing API (dạng act_XXXXXXXXX)
FACEBOOK_AD_ACCOUNT_ID=""

# Phiên bản Graph API
FACEBOOK_GRAPH_VERSION="v21.0"

# ── Webhook (nhận lead realtime từ Lead Ads) ──────────────────
# Chuỗi bí mật để xác thực webhook subscription
FACEBOOK_WEBHOOK_VERIFY_TOKEN="doi-mat-khau-nay"
