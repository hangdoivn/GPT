// Data model cho app quản lý fanpage Hàng Đôi
// PostgreSQL cho production/deploy. Test local nhanh có thể tạm đổi sang sqlite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Kết nối Facebook (OAuth) — bản ghi đơn (singleton) ────────
model FbConnection {
  id                 String    @id @default("singleton")
  userToken          String // long-lived user token (dùng cho Marketing API)
  userTokenExpiresAt DateTime?
  activePageFbId     String? // page đang được chọn để quản lý
  adAccountId        String? // act_XXXX lấy tự động khi kết nối
  connectedName      String? // tên user Facebook đã kết nối
  updatedAt          DateTime  @updatedAt
}

// ─── Mục tiêu xây page (số follower/reach + tệp mục tiêu) — singleton ──
model Goal {
  id                 String    @id @default("singleton")
  targetFollowers    Int? // đích số follower
  targetReachPerWeek Int? // đích reach mỗi tuần
  targetPostsPerWeek Int? // đích số bài/tuần
  deadline           DateTime? // hạn đạt mục tiêu
  audienceNote       String? // mô tả tệp mục tiêu (vd "chủ nhà hàng/quán F&B Đà Nẵng")
  icpMonthlyMinVnd   Int? // ngưỡng doanh thu/ngân sách tối thiểu của tệp khách cao cấp (VND/tháng)
  icpNote            String? // mô tả tệp khách cao cấp muốn nhắm
  baselineFollowers  Int? // follower lúc đặt mục tiêu (đo tiến độ)
  baselineAt         DateTime? // thời điểm đặt mục tiêu
  updatedAt          DateTime  @updatedAt
}

// ─── Cấu hình đồng bộ định kỳ — bản ghi đơn (singleton) ────────
model SyncConfig {
  id              String    @id @default("singleton")
  enabled         Boolean   @default(false)
  intervalMinutes Int       @default(60)
  lastSyncAt      DateTime?
  lastStatus      String? // ok | error | skipped
  lastMessage     String?
  updatedAt       DateTime  @updatedAt
}

// ─── Fanpage đang quản lý ──────────────────────────────────────
model Page {
  id          String   @id @default(cuid())
  fbPageId    String   @unique // ID page trên Facebook
  name        String
  accessToken String? // page access token (mã hoá ở production)
  igUserId    String? // ID tài khoản Instagram business liên kết page (Copy IG→Fanpage)
  category    String?
  followers   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]
  leads     Lead[]
  posts     Post[]
}

// ─── Chiến dịch quảng cáo ──────────────────────────────────────
model Campaign {
  id          String   @id @default(cuid())
  fbCampaignId String  @unique
  pageId      String
  name        String
  objective   String? // LEAD_GENERATION, MESSAGES, ...
  status      String   @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  dailyBudget Float    @default(0)
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@index([pageId])
}

// ─── Lead thu về từ ads / form / inbox ─────────────────────────
model Lead {
  id         String   @id @default(cuid())
  fbLeadId   String?  @unique // ID lead trên Facebook (nếu từ Lead Ads)
  pageId     String
  campaignId String?

  fullName String
  phone    String?
  email    String?
  province String? // tỉnh/thành khách khai
  message  String? // nội dung khách để lại
  source   String   @default("lead_ad") // lead_ad, messenger, comment, manual, csv

  // Kết quả chấm điểm chất lượng (0-100) và phân loại
  score       Int    @default(0)
  quality     String @default("unscored") // good, warm, junk, unscored
  scoreReasons String? // JSON array lý do (giải thích vì sao rác)

  // Trạng thái chăm sóc (CRM)
  crmStatus String  @default("new") // new, contacted, qualified, won, lost
  assignee  String?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([campaignId])
  @@index([quality])
  @@index([crmStatus])
}

// ─── Bài đăng / lịch nội dung ──────────────────────────────────
model Post {
  id          String    @id @default(cuid())
  fbPostId    String?   @unique
  pageId      String
  content     String
  mediaUrl    String?
  // ─ Content Planner (Phase 1) ─
  mediaType       String? // TEXT | IMAGE | VIDEO | CAROUSEL_ALBUM
  mediaUrls       Json? // đa ảnh (carousel); ảnh/video = 1 phần tử
  fbPermalink     String?
  error           String?
  source          String? // manual | upload | ig_repost | fb_repost
  sourceIgMediaId String? // nếu asset lấy từ bài IG → re-resolve URL tươi khi đăng
  sourceFbId      String? // fbPageId của page nguồn (cho re-resolve IG)
  status      String    @default("draft") // draft, scheduled, published, failed
  scheduledAt DateTime?
  publishedAt DateTime?
  likes       Int       @default(0)
  comments    Int       @default(0)
  shares      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([status])
  @@index([scheduledAt])
}

// ─── Copy bài Instagram → Fanpage: nhật ký chống trùng ─────────
// Chống trùng theo (igMediaId, targetPageId): 1 bài IG chỉ đăng 1 lần cho mỗi page đích.
model CopiedPost {
  id               String    @id @default(cuid())
  igMediaId        String
  targetPageId     String // fbPageId của page đích
  sourcePageId     String? // fbPageId của page có IG nguồn
  igCaption        String?
  rewrittenCaption String?
  mediaType        String? // IMAGE | VIDEO | CAROUSEL_ALBUM
  mediaUrls        Json?
  status           String    @default("pending") // pending, rewritten, published, failed, skipped
  fbPostId         String?
  fbPermalink      String?
  error            String?
  igTimestamp      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([igMediaId, targetPageId])
  @@index([status])
  @@index([targetPageId])
}

// ─── Định vị fanpage đích (dùng cho AI viết lại caption) ────────
model PagePositioning {
  id        String   @id @default(cuid())
  pageId    String   @unique // fbPageId của page đích
  pageName  String?
  audience  String?
  voice     String?
  hashtags  String?
  cta       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
